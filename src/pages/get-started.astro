---
import BaseLayout from '../layouts/BaseLayout.astro';

const mcpConfig = `# claude_desktop_config.json (or your MCP host)
{
  "mcpServers": {
    "nox": {
      "command": "nox",
      "args": ["serve", "--allowed-paths", "/path/to/repo"]
    }
  }
}`;
---

<BaseLayout title="NOX — Get Started" description="Install and run NOX in minutes.">
  <main>
    <section class="section container intro">
      <p class="kicker">Get started</p>
      <h1>From install to enforcement in minutes.</h1>
      <p>Start with the smallest useful workflow, then add CI enforcement and plugins incrementally.</p>
    </section>

    <section class="section container timeline">
      <article class="step reveal">
        <span class="step-num">01</span>
        <div>
          <h2>Install</h2>
          <p class="step-desc">Choose the install method that fits your environment.</p>
          <div class="install-methods">
            <div class="install-method">
              <p class="method-label">Homebrew</p>
              <pre><code>brew install felixgeelhaar/tap/nox</code></pre>
              <p class="method-note">
                Tap-qualified on purpose: a bare <code>brew install nox</code> resolves to
                an unrelated package in homebrew-core.
              </p>
            </div>
            <div class="install-method">
              <p class="method-label">Go</p>
              <pre><code>go install github.com/nox-hq/nox/cli@latest</code></pre>
            </div>
            <div class="install-method">
              <p class="method-label">Docker</p>
              <pre><code>docker run --rm -v $(pwd):/workspace ghcr.io/nox-hq/nox scan /workspace</code></pre>
            </div>
            <div class="install-method">
              <p class="method-label">Build from source</p>
              <pre><code>git clone https://github.com/nox-hq/nox.git
cd nox && go build -o nox ./cli</code></pre>
            </div>
          </div>
        </div>
      </article>

      <article class="step reveal d2">
        <span class="step-num">02</span>
        <div>
          <h2>First scan</h2>
          <p class="step-desc">Run a full scan with zero configuration. Nox auto-discovers files, lockfiles, and AI components.</p>
          <pre><code>nox scan .</code></pre>
          <pre class="output"><code><span class="t-dim">nox — scanning .</span>
<span class="t-cyan">[results]</span> 12 findings, 47 dependencies, 3 AI components
<span class="t-green">[done]</span> wrote findings.json</code></pre>
          <p class="step-note">
            If a check could not complete — OSV unreachable, a required plugin missing, a
            lockfile nox cannot parse — it is reported as a <code>[degraded]</code> line on
            stderr and recorded in <code>findings.json</code> under <code>meta.degradations</code>,
            rather than passing as a clean scan. Add <code>--fail-on-degraded</code> to make
            CI treat that as failure.
          </p>
        </div>
      </article>

      <article class="step reveal d3">
        <span class="step-num">03</span>
        <div>
          <h2>CI integration</h2>
          <p class="step-desc">Add Nox to your GitHub Actions workflow with inline PR annotations and SARIF upload for Code Scanning alerts.</p>
          <pre><code>name: Security Scan
on: [push, pull_request]
jobs:
  nox:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: nox-hq/nox@v1
        with:
          path: '.'
          format: sarif
          annotate: 'true'          # inline PR comments
          severity-threshold: high
          fail-on-degraded: 'true'  # a check that could not run fails the job
      - uses: github/codeql-action/upload-sarif@v3
        with:
          sarif_file: results.sarif</code></pre>
          <p class="step-note">
            SARIF carries <code>security-severity</code>, so Code Scanning can sort, filter
            and write alert rules against Nox findings rather than treating every alert alike.
          </p>
        </div>
      </article>

      <article class="step reveal">
        <span class="step-num">3b</span>
        <div>
          <h2>Automated dependency remediation</h2>
          <p class="step-desc">Open a PR that upgrades vulnerable dependencies on a schedule, with the project's own test suite as the gate.</p>
          <pre><code>name: Nox Remediation
on:
  schedule:
    - cron: '0 3 * * 1-5'
  workflow_dispatch:
permissions:
  contents: write
  pull-requests: write
jobs:
  remediate:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - uses: nox-hq/nox-remediate-action@v1
        with:
          path: .
          verify-cmd: 'go test ./...'</code></pre>
        </div>
      </article>

      <article class="step reveal">
        <span class="step-num">04</span>
        <div>
          <h2>Dashboard</h2>
          <p class="step-desc">Generate a standalone HTML report for visual inspection and team review. It is written from an existing <code>findings.json</code>, and honors <code>SOURCE_DATE_EPOCH</code> so the output is reproducible.</p>
          <pre><code>nox dashboard .                              # opens in your browser
nox dashboard . --no-browser --output report.html</code></pre>
        </div>
      </article>

      <article class="step reveal d2">
        <span class="step-num">05</span>
        <div>
          <h2>Configure</h2>
          <p class="step-desc">Create a <code>.nox.yaml</code> to customize severity thresholds, rule overrides, and output paths.</p>
          <pre><code># .nox.yaml
severity: medium
formats:
  - json
  - sarif
  - cdx
output: reports/
rules:
  SEC-042:
    severity: critical
  IAC-101:
    enabled: false
suppress:
  - id: SEC-007
    reason: "Test credential, rotated weekly"
    expires: "2026-06-01"</code></pre>
        </div>
      </article>

      <article class="step reveal d3">
        <span class="step-num">06</span>
        <div>
          <h2>Declare plugins (.nox.yaml)</h2>
          <p class="step-desc">Treat security plugins like dependencies. Pin them in <code>.nox.yaml</code> so anyone cloning your repo gets the same verified set on first scan.</p>
          <pre><code># .nox.yaml — package.json for security
plugins:
  required:
    - nox/reachability        # filter VULN by import reachability
    - nox/taint-analysis      # cross-file + AI taint flow
    - nox/k8s-runtime         # live cluster scanning
    - nox/grc                 # 10 compliance frameworks
  trust_policy: default       # require Cosign keyless or Ed25519

# First scan auto-installs missing required plugins.
# Verified end-to-end via Sigstore — install fails closed
# on unsigned third-party drops.</code></pre>
          <pre><code>nox install                  # fetch all required plugins
nox scan .                   # auto-installs if missing</code></pre>
        </div>
      </article>

      <article class="step reveal">
        <span class="step-num">07</span>
        <div>
          <h2>Verify a release out-of-band</h2>
          <p class="step-desc">Every plugin in the official registry signs its checksums via Sigstore keyless OIDC. The same chain Nox runs at install — reproducible by hand:</p>
          <pre><code>cosign verify-blob \
  --certificate-identity-regexp \
    "https://github.com/nox-hq/nox-plugin-reachability/.github/workflows/release.yml@.*" \
  --certificate-oidc-issuer https://token.actions.githubusercontent.com \
  --bundle checksums.txt.sigstore.json \
  --new-bundle-format \
  checksums.txt</code></pre>
          <p class="step-note">
            Plugin releases sign with cosign v4, which writes a single
            <code>checksums.txt.sigstore.json</code> bundle and no detached
            <code>.sig</code>.
          </p>
        </div>
      </article>

      <article class="step reveal d2">
        <span class="step-num">08</span>
        <div>
          <h2>Give your AI agent secure access (MCP)</h2>
          <p class="step-desc">Let Claude / Cursor / any MCP-aware agent read scan results without giving it write access or shell. Read-only tools, workspace allowlisting, output size limits.</p>
          <pre><code>{mcpConfig}</code></pre>
        </div>
      </article>
    </section>
  </main>
</BaseLayout>

<style>
  .intro p {
    max-width: 67ch;
  }

  .timeline {
    display: grid;
    gap: 1rem;
  }

  .step {
    display: grid;
    grid-template-columns: 72px 1fr;
    gap: 0.9rem;
    align-items: start;
    padding-top: 0.4rem;
  }

  .step + .step {
    border-top: 1px solid var(--line);
    padding-top: 1rem;
  }

  .step-num {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--text);
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1rem;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .step h2 {
    font-size: 1.2rem;
    margin-bottom: 0.35rem;
  }

  .step-desc {
    max-width: 60ch;
    margin: 0 0 0.6rem;
    font-size: 0.9rem;
  }

  .step-desc code {
    color: var(--code-accent);
    font-size: 0.86rem;
  }

  .step-note {
    margin: 0.6rem 0 0;
    max-width: 66ch;
    font-size: 0.85rem;
    line-height: 1.55;
    color: var(--muted);
  }

  .step-note code {
    color: var(--code-accent);
    font-size: 0.85em;
  }

  .install-methods {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.7rem;
  }

  .install-method {
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
    padding: 0.7rem;
  }

  .method-label {
    margin: 0 0 0.35rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text);
  }

  .method-note {
    margin: 0.45rem 0 0;
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--muted);
  }

  .method-note code {
    color: var(--code-accent);
    font-size: 0.85em;
  }

  .install-method pre {
    font-size: 0.8rem;
    padding: 0.6rem 0.75rem;
  }

  pre.output {
    margin-top: 0.5rem;
    opacity: 0.85;
  }

  pre.output :global(.t-dim) {
    color: #6a7faa;
  }

  pre.output :global(.t-cyan) {
    color: #39c8f4;
  }

  pre.output :global(.t-green) {
    color: #28c840;
  }

  @media (max-width: 960px) {
    .install-methods {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 720px) {
    .step {
      grid-template-columns: 1fr;
    }
  }
</style>
