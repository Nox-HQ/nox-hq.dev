---
import BaseLayout from '../layouts/BaseLayout.astro';
import { pluginTracks, currentPluginCount, pluginTotalCount, verifiedPlugins } from '../data/plugins';

const ciSafeCount = pluginTracks.filter((track) => track.ciSafe === 'yes').length;
const trackCount = pluginTracks.length;
const supersededCount = pluginTotalCount - currentPluginCount;
---

<BaseLayout title="Nox — Plugin Marketplace" description="Cosign-signed plugin marketplace. Track-based architecture with explicit safety context for every plugin.">
  <main>
    <section class="section container intro">
      <p class="kicker">Plugin marketplace</p>
      <h1>Cosign-signed plugins, track-based safety guarantees.</h1>
      <p>
        The official registry serves {currentPluginCount} current plugins across {trackCount} tracks. Every one carries a Sigstore keyless signature tied to its `release.yml` workflow OIDC subject. The default trust policy refuses install on unsigned drops; operators bypass with `--allow-unverified` or `plugins.trust_policy: permissive`. Since 1.13.0 the trust policy is enforced on install, update and `.nox.yaml` auto-install alike, and a plugin binary is re-verified against its install-time digest before it runs.
      </p>
      <p class="registry-note">
        The registry moved to its own repository,
        <a href="https://github.com/nox-hq/registry" rel="noreferrer">Nox-HQ/registry</a>, in nox 1.10.0.
        Existing installs migrate the source URL automatically.
      </p>

      <div class="summary reveal">
        <article>
          <p>Current plugins</p>
          <strong class="metric-value">{currentPluginCount}</strong>
        </article>
        <article>
          <p>Cosign verified</p>
          <strong class="metric-value">{verifiedPlugins.length}/{currentPluginCount}</strong>
        </article>
        <article>
          <p>CI-safe tracks</p>
          <strong class="metric-value">{ciSafeCount}/{trackCount}</strong>
        </article>
      </div>
      <p class="superseded-note">
        {supersededCount} further entries stay in the index for existing installs but are no longer recommended — marked below.
      </p>
    </section>

    <section class="section container">
      <div class="verified-header">
        <p class="kicker">✓ Cosign keyless verified</p>
        <h2>Featured: signed plugins ready for production</h2>
      </div>
      <div class="verified-grid">
        {verifiedPlugins.map((p) => (
          <article class="verified-card reveal">
            <div class="verified-top">
              <code>{p.name}</code>
              <span class="verified-badge">✓ Verified</span>
            </div>
            <p>{p.summary}</p>
            <pre class="verified-install"><code>nox plugin install {p.name}</code></pre>
          </article>
        ))}
      </div>
    </section>

    <section class="section container catalog" aria-label="Plugin track catalog">
      {pluginTracks.map((track, index) => (
        <details class={`track reveal ${index % 3 === 1 ? 'd2' : index % 3 === 2 ? 'd3' : ''}`} open={index < 3}>
          <summary>
            <div>
              <p class="track-id">Track {track.number}</p>
              <h2>{track.title}</h2>
              <p class="track-desc">{track.description}</p>
            </div>
            <ul>
              <li>{track.riskClass}</li>
              <li>CI {track.ciSafe}</li>
              <li>Offline {track.offline}</li>
              <li>RO {track.readOnly}</li>
            </ul>
          </summary>

          <ul class="plugins">
            {track.plugins.map((plugin) => (
              <li data-status={plugin.status ?? 'current'}>
                <div class="plugin-name">
                  <code>{plugin.name}</code>
                  {plugin.version && <span class="plugin-version">v{plugin.version}</span>}
                  {plugin.status === 'deprecated' && <span class="status-badge deprecated">Deprecated</span>}
                  {plugin.status === 'retired' && <span class="status-badge retired">Retired</span>}
                  {plugin.verified && (plugin.status ?? 'current') === 'current' && (
                    <span class="verified-badge inline">✓ Verified</span>
                  )}
                </div>
                <span>
                  {plugin.summary}
                  {plugin.replacedBy && <em class="replaced-by"> Use {plugin.replacedBy} instead.</em>}
                </span>
              </li>
            ))}
          </ul>
        </details>
      ))}
    </section>
  </main>
</BaseLayout>

<style>
  .intro p {
    max-width: 74ch;
  }

  .summary {
    margin-top: 1rem;
    display: grid;
    gap: 0.8rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .summary article {
    border: 1px solid var(--line);
    border-radius: 14px;
    background: linear-gradient(165deg, var(--surface), var(--surface-soft));
    padding: 0.85rem;
  }

  .summary p {
    margin: 0 0 0.3rem;
    font-size: 0.8rem;
  }

  .catalog {
    display: grid;
    gap: 0.8rem;
  }

  .track {
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--surface);
    padding: 0.85rem;
  }

  .track summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: flex-start;
  }

  .track summary::-webkit-details-marker {
    display: none;
  }

  .track-id {
    margin: 0;
    color: var(--cyan);
    font-size: 0.73rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .track h2 {
    margin: 0.3rem 0 0;
    font-size: 1.2rem;
  }

  .track-desc {
    margin: 0.45rem 0 0;
    max-width: 64ch;
    font-size: 0.92rem;
  }

  .track summary ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .track summary li {
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.28rem 0.52rem;
    font-size: 0.76rem;
    color: var(--muted);
    text-transform: capitalize;
    background: var(--surface-soft);
  }

  .verified-header {
    margin-bottom: 1rem;
  }

  .verified-header .kicker {
    color: #28c840;
  }

  .verified-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .verified-card {
    border: 1px solid var(--line);
    border-radius: 14px;
    background: linear-gradient(165deg, var(--surface), var(--surface-soft));
    padding: 1rem;
  }

  .verified-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  .verified-top code {
    font-size: 0.92rem;
    color: var(--code-accent);
  }

  .verified-badge {
    background: rgba(40, 200, 64, 0.1);
    color: #28c840;
    border: 1px solid rgba(40, 200, 64, 0.35);
    border-radius: 999px;
    padding: 0.18rem 0.5rem;
    font-size: 0.72rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .verified-badge.inline {
    font-size: 0.66rem;
    padding: 0.12rem 0.4rem;
  }

  .verified-card p {
    margin: 0 0 0.6rem;
    font-size: 0.86rem;
    line-height: 1.5;
  }

  .verified-install {
    margin: 0;
    padding: 0.55rem 0.7rem;
    font-size: 0.78rem;
  }

  .plugins {
    margin: 0.8rem 0 0;
    padding: 0.8rem 0 0 1rem;
    border-top: 1px solid var(--line);
    display: grid;
    gap: 0.44rem;
  }

  .plugins li {
    display: grid;
    gap: 0.16rem;
  }

  .plugin-name {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .plugins code {
    color: var(--code-accent);
    font-size: 0.86rem;
  }

  .plugins span {
    color: var(--muted);
    font-size: 0.88rem;
  }

  /* A superseded plugin stays listed for operators who already run it, but
     should not read as an equal recommendation next to a current one. */
  .plugins li[data-status='deprecated'],
  .plugins li[data-status='retired'] {
    opacity: 0.72;
  }

  .plugin-version {
    color: var(--muted);
    font-size: 0.74rem !important;
    font-variant-numeric: tabular-nums;
  }

  .status-badge {
    border-radius: 999px;
    padding: 0.14rem 0.45rem;
    font-size: 0.68rem !important;
    font-weight: 600;
    white-space: nowrap;
  }

  .status-badge.deprecated {
    color: #febc2e;
    border: 1px solid rgba(254, 188, 46, 0.4);
    background: rgba(254, 188, 46, 0.1);
  }

  .status-badge.retired {
    color: #ff6b6b;
    border: 1px solid rgba(255, 107, 107, 0.4);
    background: rgba(255, 107, 107, 0.1);
  }

  .replaced-by {
    color: var(--text);
    font-style: normal;
  }

  .registry-note,
  .superseded-note {
    font-size: 0.85rem;
    max-width: 70ch;
  }

  .superseded-note {
    margin-top: 0.7rem;
  }

  .registry-note a {
    color: var(--cyan);
  }

  @media (max-width: 960px) {
    .summary {
      grid-template-columns: 1fr;
    }

    .track summary {
      flex-direction: column;
    }

    .verified-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
