---
import BaseLayout from '../layouts/BaseLayout.astro';
import { pluginTracks, pluginTotalCount, verifiedPlugins } from '../data/plugins';

const ciSafeCount = pluginTracks.filter((track) => track.ciSafe === 'yes').length;
const trackCount = pluginTracks.length;
---

<BaseLayout title="Nox — Plugin Marketplace" description="Cosign-signed plugin marketplace. Track-based architecture with explicit safety context for every plugin.">
  <main>
    <section class="section container intro">
      <p class="kicker">Plugin marketplace</p>
      <h1>Cosign-signed plugins, track-based safety guarantees.</h1>
      <p>
        Nox ships {trackCount} tracks and {pluginTotalCount} plugins. Every plugin in the official registry carries a Sigstore keyless signature tied to its `release.yml` workflow OIDC subject. The default trust policy refuses install on unsigned drops; operators bypass with `--allow-unverified` or `plugins.trust_policy: permissive`.
      </p>

      <div class="summary reveal">
        <article>
          <p>Verified in marketplace</p>
          <strong class="metric-value">{verifiedPlugins.length}</strong>
        </article>
        <article>
          <p>Total plugins</p>
          <strong class="metric-value">{pluginTotalCount}</strong>
        </article>
        <article>
          <p>CI-safe tracks</p>
          <strong class="metric-value">{ciSafeCount}/{trackCount}</strong>
        </article>
      </div>
    </section>

    <section class="section container">
      <div class="verified-header">
        <p class="kicker">✓ Cosign keyless verified</p>
        <h2>Featured: signed plugins ready for production</h2>
      </div>
      <div class="verified-grid">
        {verifiedPlugins.map((p) => (
          <article class="verified-card reveal">
            <div class="verified-top">
              <code>nox/{p.name.replace(/^nox-plugin-/, '')}</code>
              <span class="verified-badge">✓ Verified</span>
            </div>
            <p>{p.summary}</p>
            <pre class="verified-install"><code>nox plugin install nox/{p.name.replace(/^nox-plugin-/, '')}</code></pre>
          </article>
        ))}
      </div>
    </section>

    <section class="section container catalog" aria-label="Plugin track catalog">
      {pluginTracks.map((track, index) => (
        <details class={`track reveal ${index % 3 === 1 ? 'd2' : index % 3 === 2 ? 'd3' : ''}`} open={index < 3}>
          <summary>
            <div>
              <p class="track-id">Track {track.number}</p>
              <h2>{track.title}</h2>
              <p class="track-desc">{track.description}</p>
            </div>
            <ul>
              <li>{track.riskClass}</li>
              <li>CI {track.ciSafe}</li>
              <li>Offline {track.offline}</li>
              <li>RO {track.readOnly}</li>
            </ul>
          </summary>

          <ul class="plugins">
            {track.plugins.map((plugin) => (
              <li>
                <div class="plugin-name">
                  <code>{plugin.name}</code>
                  {plugin.verified && <span class="verified-badge inline">✓ Verified</span>}
                </div>
                <span>{plugin.summary}</span>
              </li>
            ))}
          </ul>
        </details>
      ))}
    </section>
  </main>
</BaseLayout>

<style>
  .intro p {
    max-width: 74ch;
  }

  .summary {
    margin-top: 1rem;
    display: grid;
    gap: 0.8rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .summary article {
    border: 1px solid var(--line);
    border-radius: 14px;
    background: linear-gradient(165deg, var(--surface), var(--surface-soft));
    padding: 0.85rem;
  }

  .summary p {
    margin: 0 0 0.3rem;
    font-size: 0.8rem;
  }

  .catalog {
    display: grid;
    gap: 0.8rem;
  }

  .track {
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--surface);
    padding: 0.85rem;
  }

  .track summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: flex-start;
  }

  .track summary::-webkit-details-marker {
    display: none;
  }

  .track-id {
    margin: 0;
    color: var(--cyan);
    font-size: 0.73rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .track h2 {
    margin: 0.3rem 0 0;
    font-size: 1.2rem;
  }

  .track-desc {
    margin: 0.45rem 0 0;
    max-width: 64ch;
    font-size: 0.92rem;
  }

  .track summary ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .track summary li {
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.28rem 0.52rem;
    font-size: 0.76rem;
    color: var(--muted);
    text-transform: capitalize;
    background: var(--surface-soft);
  }

  .verified-header {
    margin-bottom: 1rem;
  }

  .verified-header .kicker {
    color: #28c840;
  }

  .verified-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .verified-card {
    border: 1px solid var(--line);
    border-radius: 14px;
    background: linear-gradient(165deg, var(--surface), var(--surface-soft));
    padding: 1rem;
  }

  .verified-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  .verified-top code {
    font-size: 0.92rem;
    color: var(--code-accent);
  }

  .verified-badge {
    background: rgba(40, 200, 64, 0.1);
    color: #28c840;
    border: 1px solid rgba(40, 200, 64, 0.35);
    border-radius: 999px;
    padding: 0.18rem 0.5rem;
    font-size: 0.72rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .verified-badge.inline {
    font-size: 0.66rem;
    padding: 0.12rem 0.4rem;
  }

  .verified-card p {
    margin: 0 0 0.6rem;
    font-size: 0.86rem;
    line-height: 1.5;
  }

  .verified-install {
    margin: 0;
    padding: 0.55rem 0.7rem;
    font-size: 0.78rem;
  }

  .plugins {
    margin: 0.8rem 0 0;
    padding: 0.8rem 0 0 1rem;
    border-top: 1px solid var(--line);
    display: grid;
    gap: 0.44rem;
  }

  .plugins li {
    display: grid;
    gap: 0.16rem;
  }

  .plugin-name {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .plugins code {
    color: var(--code-accent);
    font-size: 0.86rem;
  }

  .plugins span {
    color: var(--muted);
    font-size: 0.88rem;
  }

  @media (max-width: 960px) {
    .summary {
      grid-template-columns: 1fr;
    }

    .track summary {
      flex-direction: column;
    }

    .verified-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
