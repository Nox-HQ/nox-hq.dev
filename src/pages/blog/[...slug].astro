---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content } = await post.render();
const fmt = new Intl.DateTimeFormat('en-US', { dateStyle: 'long' });

const publishedISO = post.data.publishedAt.toISOString();
const postURL = new URL(`/blog/${post.slug}`, 'https://nox-hq.dev').href;
const blogPostingLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: publishedISO,
  author: { '@type': 'Organization', name: post.data.author },
  publisher: {
    '@type': 'Organization',
    name: 'Nox',
    logo: { '@type': 'ImageObject', url: 'https://nox-hq.dev/nox-logo.png' },
  },
  keywords: post.data.tags.join(', '),
  mainEntityOfPage: { '@type': 'WebPage', '@id': postURL },
  url: postURL,
};
---

<BaseLayout
  title={`${post.data.title} — Nox blog`}
  description={post.data.description}
  ogType="article"
  article={{ publishedTime: publishedISO, author: post.data.author, tags: post.data.tags }}
  jsonLd={blogPostingLd}
>
  <main>
    <article class="section container post">
      <p class="kicker">
        <a href="/blog">← All posts</a> · {fmt.format(post.data.publishedAt)} · {post.data.author}
      </p>
      <h1>{post.data.title}</h1>
      <p class="lede">{post.data.description}</p>

      <div class="prose">
        <Content />
      </div>

      <ul class="tags">
        {post.data.tags.map((t) => <li>{t}</li>)}
      </ul>
    </article>
  </main>
</BaseLayout>

<style>
  .post { max-width: 78ch; margin: 0 auto; }
  .lede {
    font-size: 1.1rem;
    color: var(--muted);
    line-height: 1.65;
    margin: 0.5rem 0 1.6rem;
  }
  .prose :global(h2) { margin: 2rem 0 0.8rem; font-size: 1.5rem; }
  .prose :global(h3) { margin: 1.5rem 0 0.6rem; font-size: 1.2rem; }
  .prose :global(p) { margin: 0 0 1rem; line-height: 1.7; }
  .prose :global(ul), .prose :global(ol) {
    margin: 0.5rem 0 1rem;
    padding-left: 1.2rem;
    line-height: 1.7;
    color: var(--muted);
  }
  .prose :global(ul li), .prose :global(ol li) { margin-bottom: 0.4rem; }
  .prose :global(strong) { color: var(--text); }
  .prose :global(code) {
    background: var(--surface);
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
    font-size: 0.88em;
  }
  .prose :global(pre) {
    margin: 1.2rem 0;
    font-size: 0.85rem;
  }
  .prose :global(pre code) {
    background: transparent;
    padding: 0;
  }
  .prose :global(a) {
    color: var(--cyan);
    text-decoration: underline;
    text-decoration-color: rgba(57, 200, 244, 0.4);
  }
  .prose :global(blockquote) {
    border-left: 3px solid var(--cyan);
    margin: 1.2rem 0;
    padding: 0.4rem 1rem;
    color: var(--muted);
  }
  .tags {
    margin: 2rem 0 0;
    padding: 1rem 0 0;
    border-top: 1px solid var(--line);
    list-style: none;
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
  }
  .tags li {
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.2rem 0.55rem;
    font-size: 0.72rem;
    color: var(--muted);
  }
</style>
