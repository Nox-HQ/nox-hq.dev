---
import '@fontsource/space-grotesk/400.css';
import '@fontsource/space-grotesk/700.css';
import '@fontsource/sora/400.css';
import '@fontsource/sora/600.css';
import '../styles/global.css';

import { siteNav } from '../data/site';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
}

const { title, description, ogImage = '/og-image.png' } = Astro.props;
const pathname = Astro.url.pathname;
const canonicalURL = new URL(pathname, 'https://nox-hq.dev').href;
const ogImageURL = new URL(ogImage, 'https://nox-hq.dev').href;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/nox-logo.png" />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>

    <!-- OpenGraph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content="Nox" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Additional SEO -->
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#090f23" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f6f9ff" media="(prefers-color-scheme: light)" />
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('nox-theme');
        if (saved === 'light' || saved === 'dark') {
          document.documentElement.setAttribute('data-theme', saved);
        }
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="container inner">
        <a class="brand" href="/" aria-label="NOX home">
          <img src="/nox-logo.png" alt="NOX logo" />
          <span>NOX</span>
        </a>

        <nav aria-label="Primary navigation">
          {siteNav.map((item) => (
            <a href={item.href} class={pathname === item.href ? 'active' : ''}>{item.label}</a>
          ))}
        </nav>

        <div class="header-actions">
          <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Toggle theme">
            <svg class="icon icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
            <svg class="icon icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
            <svg class="icon icon-auto" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a10 10 0 0 1 0 20V2z" fill="currentColor" stroke="none"/></svg>
          </button>
          <a class="btn ghost nav" href="https://github.com/Nox-HQ/nox" target="_blank" rel="noreferrer">GitHub</a>
        </div>
      </div>
    </header>

    <slot />

    <footer class="container footer">
      <p>NOX is open source under Apache-2.0.</p>
    </footer>

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "Nox",
      "description": "Language-agnostic security scanner with first-class AI application security.",
      "url": "https://nox-hq.dev",
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": "macOS, Linux, Windows",
      "license": "https://opensource.org/licenses/Apache-2.0",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "codeRepository": "https://github.com/nox-hq/nox",
      "programmingLanguage": "Go"
    })} />

    <script is:inline>
      (() => {
        const key = 'nox-theme';
        const root = document.documentElement;
        const button = document.getElementById('theme-toggle');
        if (!button) return;
        const order = ['auto', 'light', 'dark'];

        const read = () => {
          const value = localStorage.getItem(key);
          return value === 'light' || value === 'dark' ? value : 'auto';
        };

        const updateIcon = (theme) => {
          button.querySelectorAll('.icon').forEach(i => i.style.display = 'none');
          if (theme === 'light') {
            button.querySelector('.icon-sun').style.display = 'block';
          } else if (theme === 'dark') {
            button.querySelector('.icon-moon').style.display = 'block';
          } else {
            button.querySelector('.icon-auto').style.display = 'block';
          }
        };

        const apply = (theme) => {
          if (theme === 'auto') {
            root.removeAttribute('data-theme');
            localStorage.removeItem(key);
          } else {
            root.setAttribute('data-theme', theme);
            localStorage.setItem(key, theme);
          }
          const labels = { auto: 'System theme', light: 'Light theme', dark: 'Dark theme' };
          button.setAttribute('aria-label', labels[theme]);
          button.setAttribute('title', labels[theme]);
          updateIcon(theme);
        };

        let current = read();
        apply(current);

        button.addEventListener('click', () => {
          current = order[(order.indexOf(current) + 1) % order.length];
          apply(current);
        });
      })();
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--header-bg);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--header-border);
    box-shadow: var(--header-shadow);
  }

  .inner {
    min-height: 76px;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.06rem;
    font-weight: 700;
  }

  .brand img {
    width: 34px;
    height: 34px;
  }

  nav {
    display: flex;
    justify-content: center;
    gap: 0.3rem;
    flex-wrap: wrap;
  }

  nav a {
    text-decoration: none;
    color: var(--muted);
    border-radius: 999px;
    border: 1px solid transparent;
    background: var(--nav-pill-bg);
    font-size: 0.88rem;
    padding: 0.34rem 0.7rem;
    transition: border-color 180ms ease, background-color 180ms ease, color 180ms ease;
  }

  nav a.active,
  nav a:hover {
    color: var(--nav-pill-active-text);
    border-color: var(--nav-pill-active-border);
    background: var(--nav-pill-active-bg);
  }

  .header-actions {
    display: inline-flex;
    align-items: center;
    gap: 0.42rem;
  }

  .theme-toggle {
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: var(--btn-nav-bg);
    color: var(--muted);
    padding: 0;
    transition: border-color 180ms ease, color 180ms ease;
  }

  .theme-toggle:hover {
    border-color: var(--nav-pill-active-border);
    color: var(--text);
  }

  .theme-toggle .icon {
    display: none;
  }

  .footer {
    border-top: 1px solid var(--line);
    padding: 1.05rem 0 2.1rem;
    margin-top: 1.2rem;
  }

  .footer p {
    margin: 0;
    font-size: 0.84rem;
  }

  @media (max-width: 960px) {
    .inner {
      min-height: auto;
      padding: 0.85rem 0;
      grid-template-columns: 1fr;
      justify-items: start;
    }

    nav {
      justify-content: flex-start;
    }
  }
</style>
