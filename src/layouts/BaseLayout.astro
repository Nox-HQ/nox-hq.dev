---
import '@fontsource/space-grotesk/400.css';
import '@fontsource/space-grotesk/700.css';
import '@fontsource/sora/400.css';
import '@fontsource/sora/600.css';
import '../styles/global.css';

import { siteNav } from '../data/site';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
}

const { title, description, ogImage = '/og-image.png' } = Astro.props;
const pathname = Astro.url.pathname;
const canonicalURL = new URL(pathname, 'https://nox-hq.dev').href;
const ogImageURL = new URL(ogImage, 'https://nox-hq.dev').href;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/nox-logo.png" />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>

    <!-- OpenGraph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content="Nox" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Additional SEO -->
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#090f23" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f6f9ff" media="(prefers-color-scheme: light)" />
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('nox-theme');
        if (saved === 'light' || saved === 'dark') {
          document.documentElement.setAttribute('data-theme', saved);
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container inner">
        <a class="brand" href="/" aria-label="NOX home">
          <img src="/nox-logo.png" alt="NOX logo" />
          <span>NOX</span>
        </a>

        <nav aria-label="Primary navigation">
          {siteNav.map((item) => (
            <a href={item.href} class={pathname === item.href ? 'active' : ''}>{item.label}</a>
          ))}
        </nav>

        <div class="header-actions">
          <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Toggle theme">
            <svg class="icon icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
            <svg class="icon icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
            <svg class="icon icon-auto" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a10 10 0 0 1 0 20V2z" fill="currentColor" stroke="none"/></svg>
          </button>
          <a class="btn ghost nav github-cta" href="https://github.com/Nox-HQ/nox" target="_blank" rel="noreferrer" aria-label="View on GitHub">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
            <span>Star</span>
            <img class="star-count" src="https://img.shields.io/github/stars/Nox-HQ/nox?style=flat&label=&color=transparent&labelColor=transparent" alt="GitHub stars" />
          </a>
        </div>
      </div>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="footer">
      <div class="container footer-inner">
        <div class="footer-col">
          <p class="footer-title">Product</p>
          <ul>
            <li><a href="/features">Features</a></li>
            <li><a href="/plugins">Marketplace</a></li>
            <li><a href="/get-started">Get Started</a></li>
            <li><a href="/compare/snyk">Migrate from Snyk</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <p class="footer-title">Community</p>
          <ul>
            <li><a href="https://github.com/Nox-HQ/nox" rel="noreferrer">GitHub</a></li>
            <li><a href="https://github.com/Nox-HQ/nox/discussions" rel="noreferrer">Discussions</a></li>
            <li><a href="https://github.com/Nox-HQ/nox/issues" rel="noreferrer">Issues</a></li>
            <li><a href="https://github.com/orgs/Nox-HQ/projects" rel="noreferrer">Roadmap</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <p class="footer-title">Resources</p>
          <ul>
            <li><a href="/security">Security policy</a></li>
            <li><a href="https://github.com/Nox-HQ/nox/blob/main/docs/marketplace.md" rel="noreferrer">Trust model</a></li>
            <li><a href="https://github.com/Nox-HQ/nox/releases" rel="noreferrer">Changelog</a></li>
            <li><a href="https://github.com/Nox-HQ/nox/blob/main/CONTRIBUTING.md" rel="noreferrer">Contributing</a></li>
          </ul>
        </div>
        <div class="footer-col footer-meta">
          <p>Open source under <a href="https://github.com/Nox-HQ/nox/blob/main/LICENSE" rel="noreferrer">Apache 2.0</a>.</p>
          <p>Plugin marketplace verified via <a href="https://www.sigstore.dev/" rel="noreferrer">Sigstore</a> keyless OIDC.</p>
          <p class="footer-license">© 2026 nox-hq</p>
        </div>
      </div>
    </footer>

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "Nox",
      "description": "Language-agnostic security scanner with first-class AI application security.",
      "url": "https://nox-hq.dev",
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": "macOS, Linux, Windows",
      "license": "https://opensource.org/licenses/Apache-2.0",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "codeRepository": "https://github.com/nox-hq/nox",
      "programmingLanguage": "Go"
    })} />

    <script is:inline>
      // Copy-to-clipboard buttons on every <pre><code>. Lazy: only
      // attach after first user interaction with the page so the
      // initial paint is not delayed by N injected DOM nodes.
      (() => {
        let injected = false;
        const inject = () => {
          if (injected) return;
          injected = true;
          document.querySelectorAll('pre').forEach((pre) => {
            if (pre.dataset.noCopy === 'true') return;
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'copy-button';
            btn.setAttribute('aria-label', 'Copy code');
            btn.innerHTML = '<svg width="11" height="11" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="4" y="4" width="9" height="9" rx="1.5"/><path d="M11 4V3a1 1 0 0 0-1-1H3a1 1 0 0 0-1 1v7a1 1 0 0 0 1 1h1"/></svg><span>Copy</span>';
            btn.addEventListener('click', async () => {
              const code = pre.querySelector('code');
              const text = (code ? code.innerText : pre.innerText).trim();
              try {
                await navigator.clipboard.writeText(text);
                btn.dataset.copied = 'true';
                btn.querySelector('span').textContent = 'Copied';
                setTimeout(() => {
                  delete btn.dataset.copied;
                  btn.querySelector('span').textContent = 'Copy';
                }, 1600);
              } catch (e) {
                btn.querySelector('span').textContent = 'Error';
              }
            });
            pre.appendChild(btn);
          });
        };
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', inject);
        } else {
          inject();
        }
      })();
    </script>

    <script is:inline>
      (() => {
        const key = 'nox-theme';
        const root = document.documentElement;
        const button = document.getElementById('theme-toggle');
        if (!button) return;
        const order = ['auto', 'light', 'dark'];

        const read = () => {
          const value = localStorage.getItem(key);
          return value === 'light' || value === 'dark' ? value : 'auto';
        };

        const updateIcon = (theme) => {
          button.querySelectorAll('.icon').forEach(i => i.style.display = 'none');
          if (theme === 'light') {
            button.querySelector('.icon-sun').style.display = 'block';
          } else if (theme === 'dark') {
            button.querySelector('.icon-moon').style.display = 'block';
          } else {
            button.querySelector('.icon-auto').style.display = 'block';
          }
        };

        const apply = (theme) => {
          if (theme === 'auto') {
            root.removeAttribute('data-theme');
            localStorage.removeItem(key);
          } else {
            root.setAttribute('data-theme', theme);
            localStorage.setItem(key, theme);
          }
          const labels = { auto: 'System theme', light: 'Light theme', dark: 'Dark theme' };
          button.setAttribute('aria-label', labels[theme]);
          button.setAttribute('title', labels[theme]);
          updateIcon(theme);
        };

        let current = read();
        apply(current);

        button.addEventListener('click', () => {
          current = order[(order.indexOf(current) + 1) % order.length];
          apply(current);
        });
      })();
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--header-bg);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--header-border);
    box-shadow: var(--header-shadow);
  }

  .inner {
    min-height: 76px;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.06rem;
    font-weight: 700;
  }

  .brand img {
    width: 34px;
    height: 34px;
  }

  nav {
    display: flex;
    justify-content: center;
    gap: 0.3rem;
    flex-wrap: wrap;
  }

  nav a {
    text-decoration: none;
    color: var(--muted);
    border-radius: 999px;
    border: 1px solid transparent;
    background: var(--nav-pill-bg);
    font-size: 0.88rem;
    padding: 0.34rem 0.7rem;
    transition: border-color 180ms ease, background-color 180ms ease, color 180ms ease;
  }

  nav a.active,
  nav a:hover {
    color: var(--nav-pill-active-text);
    border-color: var(--nav-pill-active-border);
    background: var(--nav-pill-active-bg);
  }

  .header-actions {
    display: inline-flex;
    align-items: center;
    gap: 0.42rem;
  }

  .theme-toggle {
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: var(--btn-nav-bg);
    color: var(--muted);
    padding: 0;
    transition: border-color 180ms ease, color 180ms ease;
  }

  .theme-toggle:hover {
    border-color: var(--nav-pill-active-border);
    color: var(--text);
  }

  .theme-toggle .icon {
    display: none;
  }

  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 100;
    padding: 0.6rem 1rem;
    background: var(--text);
    color: var(--bg);
    text-decoration: none;
    border-radius: 0 0 8px 0;
  }

  .skip-link:focus {
    left: 0;
  }

  main:focus {
    outline: none;
  }

  .github-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .github-cta .star-count {
    height: 18px;
    margin-left: 0.1rem;
  }

  .footer {
    border-top: 1px solid var(--line);
    padding: 2.4rem 0 2.4rem;
    margin-top: 3rem;
    background: var(--surface);
  }

  .footer-inner {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2rem;
  }

  .footer-col p,
  .footer-col li {
    margin: 0;
    font-size: 0.86rem;
    line-height: 1.7;
  }

  .footer-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-col a {
    color: var(--muted);
    text-decoration: none;
    transition: color 150ms ease;
  }

  .footer-col a:hover {
    color: var(--text);
  }

  .footer-title {
    color: var(--text);
    font-weight: 700;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.7rem !important;
  }

  .footer-meta p {
    margin-bottom: 0.4rem;
    color: var(--muted);
  }

  .footer-meta a {
    color: var(--muted);
    text-decoration: underline;
    text-decoration-color: var(--line);
  }

  .footer-license {
    margin-top: 0.8rem !important;
    font-size: 0.78rem !important;
    color: var(--muted);
  }

  /* Copy-to-clipboard buttons injected by post-render script */
  .copy-button {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.3rem 0.55rem;
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(0, 0, 0, 0.3);
    color: #b9c8ee;
    font-size: 0.72rem;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    cursor: pointer;
    opacity: 0;
    transition: opacity 150ms ease, background-color 150ms ease;
  }

  pre:hover .copy-button,
  .copy-button:focus {
    opacity: 1;
  }

  .copy-button:hover {
    background: rgba(0, 0, 0, 0.5);
    color: #fff;
  }

  .copy-button[data-copied="true"] {
    color: #28c840;
    border-color: rgba(40, 200, 64, 0.4);
  }

  pre {
    position: relative;
  }

  @media (max-width: 960px) {
    .inner {
      min-height: auto;
      padding: 0.85rem 0;
      grid-template-columns: 1fr;
      justify-items: start;
    }

    nav {
      justify-content: flex-start;
    }

    .footer-inner {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.5rem;
    }
  }

  @media (max-width: 540px) {
    .footer-inner {
      grid-template-columns: 1fr;
    }
  }
</style>
